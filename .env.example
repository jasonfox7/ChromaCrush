# ChromaCrush Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=chromacrush
DATABASE_USER=chromacrush
DATABASE_PASSWORD=chromacrush_dev
DATABASE_POOL_SIZE=5

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXPIRY_MINUTES=60

# --- App ---
APP_ENVIRONMENT=development
APP_DEBUG=false

# --- Payments (required in production) ---
# PAYMENTS_APPLE_BUNDLE_ID=com.chromacrush.app
# PAYMENTS_APPLE_SHARED_SECRET=
# PAYMENTS_GOOGLE_PACKAGE_NAME=com.chromacrush.app
# PAYMENTS_GOOGLE_SERVICE_ACCOUNT_KEY=
# PAYMENTS_WEBHOOK_APPLE_SECRET=
# PAYMENTS_WEBHOOK_GOOGLE_SECRET=
# PAYMENTS_ALLOW_SANDBOX_PURCHASES=false

# --- WebSocket ---
# WEBSOCKET_ENABLED=true
